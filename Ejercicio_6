class ControlTema {
private static ControlTema instance = null;
private String tema;
private String colorFondo;
private String colorTexto;
private ControlTema() {
System.out.println("Creando el gestor de temas...");
tema = "CLARO";
aplicarColores();
    }
public static synchronized ThemeManager getInstance() {
if (instance == null) {
instance = new ControlTema();
}
return instance;
}
private void aplicarColores() {
  if (tema.equals("CLARO")) {
colorFondo = "#FFFfF";
colorTexto = "#000000";
} else {
colorFondo = "#121221";
colorTexto = "#FFFF";
}
}
public synchronized boolean cambiarTema(String nuevoTema) {
  if (nuevoTema == null) {
System.out.println("Tema no válido. Use CLARO u OSCURO.");
return false;
}
nuevoTema = nuevoTema.toUpperCase();
  if (!nuevoTema.equals("CLARO") && !nuevoTema.equals("OSCURO")) {
System.out.println("Tema no válido. Use CLARO u OSCURO.");
return false;
}
tema = nuevoTema;
aplicarColores();
return true;
}
public synchronized void alternarTema() {
  if (tema.equals("CLARO")) {
cambiarTema("OSCURO");
} else {
cambiarTema("CLARO");
}
}
public synchronized String getTema() {
return tema;
}
public synchronized String getColorFondo() {
return colorFondo;
}
  public synchronized String getColorTexto() {
return colorTexto;
}
}
class Vista {
private String nombre;

public Vista(String nombre) {
this.nombre = nombre;
}
 public void mostrar() {
ControlTema gestor = ControlTema.getInstance();
System.out.println("Vista " + nombre + " -> tema: " + gestor.getTema()
    + ", fondo: " + gestor.getColorFondo()
    + ", texto: " + gestor.getColorTexto());
}
}
public class Main {
    public static void main(String[] args) {
Vista inicio = new Vista("Inicio");
Vista ajustes = new Vista("Ajustes");

System.out.println("--- Tema inicial ---");
inicio.mostrar();
ajustes.mostrar();

ControlTema.getInstance().cambiarTema("OSCURO");
System.out.println("--- Después de cambiar a OSCURO ---");
inicio.mostrar();
ajustes.mostrar();

ControlTema.getInstance().cambiarTema("AZUL");

ControlTema.getInstance().alternarTema();
System.out.println("--- Después de alternar ---");
inicio.mostrar();
ajustes.mostrar();

ControlTema a = ControlTema.getInstance();
ControlTema b = ControlTema.getInstance();
System.out.println("¿Son el mismo objeto? " + (a == b));
}
}
