class Tema {
private static Tema instance = null;
  private String tema;
  private String colorFondo;
  private String colorTexto;
private Tema() {
  System.out.println("Creando el gestor de temas...");
  tema = "CLARO";
  aplicarColores();
}
public static synchronized Tema getInstance() {
  if (instance == null) {
instance = new Tema();
}
return instance;
}
private void aplicarColores() {
  if (tema.equals("CLARO")) {
colorFondo = "#FFfr";
colorTexto = "#0000";
} else {
colorFondo = "#121212";
colorTexto = "#FFFFFF";
}
}
 public synchronized boolean cambiarTema(String nuevoTema) {
  if (nuevoTema == null) {
System.out.println("Tema no válido. Use CLARO o OSCURO.");
return false;
}
nuevoTema = nuevoTema.toUpperCase();
  if (!nuevoTema.equals("CLARO") && !nuevoTema.equals("OSCURO")) {
System.out.println("Tema no válido. Use CLARO o OSCURO.");
return false;
}
tema = nuevoTema;
aplicarColores();
return true;
}
public synchronized void alternarTema() {
  if (tema.equals("CLARO")) {
cambiarTema("OSCURO");
} else {
cambiarTema("CLARO");
}
}
public synchronized String getTema() {
return tema;
}
public synchronized String getColorFondo() {
return colorFondo;
}
public synchronized String getColorTexto() {
return colorTexto;
}
}
class Vista {
  private String nombre;
 public Vista(String nombre) {
this.nombre = nombre;
}
public void mostrar() {
ThemeManager gestor = Tema.getInstance();
System.out.println("Vista " + nombre + " -> tema: " + gestor.getTema()
      + ", fondo: " + gestor.getColorFondo()
      + ", texto: " + gestor.getColorTexto());
}
}

public class Main {
    public static void main(String[] args) {
Vista inicio = new Vista("Inicio");
Vista ajustes = new Vista("Ajustes");

System.out.println("--- Tema inicial ---");
inicio.mostrar();
ajustes.mostrar();

ThemeManager.getInstance().cambiarTema("OSCURO");
System.out.println("--- Después de cambiar a OSCURO ---");
inicio.mostrar();
ajustes.mostrar();

Tema.getInstance().cambiarTema("AZUL");

Tema.getInstance().alternarTema();
System.out.println("--- Después de alternar ---");
inicio.mostrar();
ajustes.mostrar();

Tema a = ThemeManager.getInstance();
Tema b = ThemeManager.getInstance();
System.out.println("¿Son el mismo objeto? " + (a == b));
    }
}
